(capture the dns queries using python script)
#!/usr/bin/env python3
from scapy.all import sniff, DNS, DNSQR, IP

def dns_query_sniffer(packet):
    if packet.haslayer(DNS) and packet[DNS].qr == 0:  # qr == 0 = query
        try:
            query = packet[DNSQR].qname.decode()
            src_ip = packet[IP].src
            print(f"[+] DNS Query from {src_ip}: {query}")
        except Exception as e:
            print(f"[!] Error decoding packet: {e}")

# Replace 'eth0' with your actual interface (e.g., wlan0, en0)
iface = "eth0"

print(f"[*] Sniffing DNS queries from other devices on interface {iface}...")
sniff(
    iface=iface,
    filter="udp port 53",
    prn=dns_query_sniffer,
    store=False
)

