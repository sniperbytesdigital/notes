#(linear regression on student dataset whether a student will pass or fail)
import pandas as pd
import numpy as np

df = pd.read_csv("https://raw.githubusercontent.com/sniperbytesdigital/files/refs/heads/main/student_marks.csv")

X = df[['study_hours', 'previous_score']]  # Changed: select numerical columns only
y = df['result'].map({'fail': 0, 'pass': 1})  # Changed: convert pass/fail to numbers

#
from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=101)

from sklearn.linear_model import LinearRegression
model = LinearRegression()
model.fit(X_train,y_train)
test_predictions = model.predict(X_test)

from sklearn.metrics import mean_absolute_error,mean_squared_error
MAE = mean_absolute_error(y_test,test_predictions)
MSE = mean_squared_error(y_test,test_predictions)
RMSE = np.sqrt(MSE)
print(MAE)
print(MSE)
print(RMSE)
#
#
new_data = [[4.5, 75], [3.0, 55]]  # Changed: now [study_hours, previous_score]
print(model.predict(new_data))




