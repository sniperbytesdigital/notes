(find mean sqaured error and root meansqaured in linearregression model using diabetis dataset)
# scikit-learn
from sklearn.linear_model import LinearRegression
from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split
import numpy as np
from sklearn.metrics import mean_squared_error

X, y = load_diabetes(return_X_y=True, as_frame=True)
X = X[["age", "bmi"]]

X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)
print(X_train.shape)
print(X_test.shape)
lin_reg_mse = LinearRegression()
lin_reg_mse.fit(X_train, y_train)
y_pred = lin_reg_mse.predict(X_test)
mse = mean_squared_error(y_pred, y_test)
print("mean squared error - ",mse)
print("root mean squared error - ",np.sqrt(mse))

new_data = [[0.9, 0], [0.5, 0.3]]
value = lin_reg_mse.predict(new_data)
print(value)
